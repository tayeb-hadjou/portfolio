---
import Button from "../components/button.astro";
import Separator from "../components/home/separator.astro";
import Layout from "../layouts/main.astro";
import Background from "../components/Background.astro";
---

<Layout title="tayeb">
  <Background />  
  <div
    id="test"
    class="w-full max-w-4xl mx-auto px-4 sm:px-6 xs:mt-16 md:mt-32 lg:mt-16 xl:px-0 mt-16"
  >
    <div class="md:h-full flex flex-col-reverse items-center md:flex-row gap-4 md:gap-8">
      <div class="mt-[40px] md:mt-24 relative w-full md:w-1/2">
        <h1
          class="mb-3 sm:mb-5 text-3xl sm:text-4xl font-bold leading-snug sm:leading-tight dark:text-white"
        >
          <span 
          class=" typing-effect"
          id="title_typing"></span>
        </h1>
        <p 
           id="att"
            class="mb-4 sm:mb-6  typing-effect text-sm sm:text-base" style="display: none;"></p>

        <div id="from_bottom" style="opacity: 0;">
          <p
          class="mb-1 font-semibold text-neutral-800 dark:text-neutral-200 text-sm sm:text-base">
            <!-- I can help you out with: -->
            Mes compétences principales :

          </p>
          <ul
            class="py-1 sm:py-2 space-y-[2px] sm:space-y-[3px] text-xs sm:text-sm list-disc list-inside  dark:text-neutral-400"
          >
            <li class="py-2">Développement fullstack, maîtrise de plusieurs langages et frameworks web front et back. <span class="font-semibold">Node.js, Next.js, Vue.js</span></li>
            <li class="py-2">Maitrise des outils et environnements de dev: <span class="font-semibold">VsCode, IntelliJ, Docker, SonarQube, et bonnes pratiques Git.</span></li>
            <li class="py-2">Autres compétences et langages maîtrisés : <span class="font-semibold">Python, C, Java</span>, DevOps (<span class="font-semibold">CI/CD, Docker</span>, Git, GitHub Actions), tests <span class="font-semibold">TDD/BDD</span>.</li>
          </ul>
          <div class="mt-4 sm:mt-6 space-y-3">
            <div class="flex flex-wrap gap-3">
                        <p
          class="mb-1 font-semibold text-neutral-800 dark:text-neutral-200 text-sm sm:text-base">
            <!-- I can help you out with: -->
            Quelques-uns de mes projets :
          </p>
          <ul
            class="py-1 sm:py-2 space-y-[2px] sm:space-y-[3px] text-xs sm:text-sm list-disc list-inside  dark:text-neutral-400"
          >
            <li class="py-2">Une web app de duel de pronostics de matchs entre amis <span class="font-semibold">Node.js</span> et <span class="font-semibold">Vue.js</span>.</li>
            <li class="py-2">Automatisation n8n de creation de clips vidéo optimisés pour les réseaux sociaux. <span class="font-semibold">n8n, python.</span>  </li>
            <li class="py-2">Application web de superposition 3D en temps réel sur un flux vidéo <span class="font-semibold">Three.js</span>.</li>
            <li class="py-2"><a href="/portfolio/projects" class="underline">Explorez mon site pour en découvrir plus</a></li>          
          </ul>

            </div>
          </div>

        </div>

        </div>
        <div id="ok" class="relative">
          <div  class="absolute p-1 sm:p-2 w-14 h-14 sm:w-16 sm:h-16 z-10 text-xl sm:text-2xl md:top-[-24px] md:left-[-24px]" 
          ><span id="shake" class="bg-white hidden flex items-center justify-center w-full h-full border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700">👋</span></div>
          <div id="image_container" class="relative bg-white w-40 h-40 sm:w-52 sm:h-52 md:w-[380px] md:h-72 rounded-full md:rounded-2xl mt-4 md:mt-0 border border-neutral-300 border-dashed md:px-10 opacity-0 transition-opacity duration-[2000ms] overflow-hidden">
            <img
              alt=""
              src="/portfolio/assets/images/photo.png"
              class="w-full h-full object-cover rounded-full md:rounded-2xl"
            />
          
        </div>
      </div>
    </div>
    </div>
          <div class="mt-2 m-auto hidden"   id="button_cv" >
            <Button link="/portfolio/assets/images/CV_Hadjou_Tayeb.pdf" variant="primary"  rel="noopener noreferrer"
              text="Télécharger mon CV"/>
              <a target="_blank" href="/portfolio/cv.html" class="underline">version html du CV</a>
          </div>
          
          
  </div>
</Layout>

<style>
  .typing-effect::after {
    content: '_';
    color : #ffdc5d;
    animation: blink 0.5s infinite;
    margin-left: 10px;
    font-weight: 900;
  }

  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
  }

  .fade-in-up {
  animation: fadeInUp 1.1s forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 1 !important;
  }

  @keyframes shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-10deg); }
    50% { transform: rotate(10deg); }
    75% { transform: rotate(-10deg); }
  }

  #shake {
    animation: shake 0.9s 2;
    transform-origin: 100% 100%;
  }


</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const titleText = "Salut, je suis Tayeb.";
    const attText = "Développeur FullStack en formation, je recherche une alternance d’un an en développement web pour ma dernière année d’études.";
    const speed = 50; // typing speed in milliseconds
    const attSpeed = speed / 5; // double the speed for 'att'
    const titleTypingElement = document.getElementById('title_typing');
    const attElement = document.getElementById('att');
    const fromBottomElement = document.getElementById('from_bottom');
    const imageContainer = document.getElementById('image_container');
    const shakeElement = document.getElementById('shake');
    const fotterElement = document.getElementById('footer');
    const headerElement = document.getElementById('header');
    const buttonCvElement = document.getElementById('button_cv');

    function typeWriter(element, text, speed, callback) {
      let index = 0;
      function type() {
        if (index < text.length) {
          element.innerHTML += text.charAt(index);
          index++;
          setTimeout(type, speed);
        } else {
          element.classList.remove('typing-effect');
          if (callback) callback();
        }
      }
      type();
    }

    function revealElements() {
      fromBottomElement.style.opacity = '1';
      fromBottomElement.classList.add('fade-in-up');
      imageContainer.classList.add('fade-in');
      shakeElement.classList.remove('hidden');
      fotterElement.classList.remove('hidden');
      fotterElement.classList.add('fade-in-up');
      headerElement.classList.remove('hidden');
      headerElement.classList.add('fade-in-up');
      buttonCvElement.classList.remove('hidden');
      buttonCvElement.classList.add('fade-in-up');

    }

    typeWriter(titleTypingElement, titleText, speed, () => {
      attElement.style.display = 'block';
      typeWriter(attElement, attText, attSpeed, revealElements);
    });
  });
</script>
