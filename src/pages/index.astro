---
import Button from "../components/button.astro";
import Separator from "../components/home/separator.astro";
import Layout from "../layouts/main.astro";
import Background from "../components/Background.astro";
---

<Layout title="tayeb">
  <Background />  
  <div
    id="test"
    class="w-full max-w-4xl mx-auto px-4 sm:px-6 md:mt-16 lg:mt-6 xl:px-0 mt-8"
  >
    <div class="md:h-full flex flex-col-reverse items-center md:flex-row gap-4 md:gap-8">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-3 sm:mb-5 text-3xl sm:text-4xl font-bold leading-snug sm:leading-tight dark:text-white"
        >
          <span 
          class=" typing-effect"
          id="title_typing"></span>
        </h1>
        <p 
           id="att"
            class="mb-4 sm:mb-6 text-neutral-600 typing-effect text-sm sm:text-base" style="display: none;"></p>

        <div id="from_bottom" style="opacity: 0;">
          <p
          class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200 text-sm sm:text-base">
            <!-- I can help you out with: -->
            Voici quelques-unes de mes compétences:

          </p>
          <ul
            class="py-1 sm:py-2 space-y-[2px] sm:space-y-[3px] text-xs sm:text-sm list-disc list-inside text-neutral-500 dark:text-neutral-400"
          >
            <li>Node.js,Next.js, Vue.js</li>
            <li>Python, Java, c#, c </li>
            <li>Explore mon site pour en découvrir plus...</li>
          </ul>
        </div>
        </div>
        <div id="ok" class="relative">
          <div  class="absolute p-1 sm:p-2 w-14 h-14 sm:w-16 sm:h-16 z-10 text-xl sm:text-2xl md:top-[-24px] md:left-[-24px]" 
          ><span id="shake" class="bg-white hidden flex items-center justify-center w-full h-full border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700">👋</span></div>
          <div id="image_container" class="relative bg-white w-40 h-40 sm:w-52 sm:h-52 md:w-[380px] md:h-72 rounded-full md:rounded-2xl mt-4 md:mt-0 border border-neutral-300 border-dashed md:px-10 opacity-0 transition-opacity duration-[2000ms] overflow-hidden">
            <img
              src="/portfolio/assets/images/photo.png"
              class="w-full h-full object-cover rounded-full md:rounded-2xl"
            />
          
        </div>
      </div>
    </div>
    </div>
    
  </div>
</Layout>

<style>
  .typing-effect::after {
    content: '_';
    color : #ffdc5d;
    animation: blink 0.5s infinite;
    margin-left: 10px;
    font-weight: 900;
  }

  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
  }

  .fade-in-up {
  animation: fadeInUp 1.1s forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 1 !important;
  }

  @keyframes shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-10deg); }
    50% { transform: rotate(10deg); }
    75% { transform: rotate(-10deg); }
  }

  #shake {
    animation: shake 0.9s 2;
    transform-origin: 100% 100%;
  }
  @media (max-width: 480px) {
    #test { margin-top: 1.5rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const titleText = "Salut, je suis Tayeb.";
    const attText = "Développeur FullStack en formation, je recherche une alternance d’un an en développement web pour ma dernière année d’études.";
    const speed = 50; // typing speed in milliseconds
    const attSpeed = speed / 5; // double the speed for 'att'
    const titleTypingElement = document.getElementById('title_typing');
    const attElement = document.getElementById('att');
    const fromBottomElement = document.getElementById('from_bottom');
    const imageContainer = document.getElementById('image_container');
    const shakeElement = document.getElementById('shake');
    const fotterElement = document.getElementById('footer');
    const headerElement = document.getElementById('header');

    function typeWriter(element, text, speed, callback) {
      let index = 0;
      function type() {
        if (index < text.length) {
          element.innerHTML += text.charAt(index);
          index++;
          setTimeout(type, speed);
        } else {
          element.classList.remove('typing-effect');
          if (callback) callback();
        }
      }
      type();
    }

    function revealElements() {
      fromBottomElement.style.opacity = '1';
      fromBottomElement.classList.add('fade-in-up');
      imageContainer.classList.add('fade-in');
      shakeElement.classList.remove('hidden');
      fotterElement.classList.remove('hidden');
      fotterElement.classList.add('fade-in-up');
      headerElement.classList.remove('hidden');
      headerElement.classList.add('fade-in-up');
    }

    typeWriter(titleTypingElement, titleText, speed, () => {
      attElement.style.display = 'block';
      typeWriter(attElement, attText, attSpeed, revealElements);
    });
  });
</script>
