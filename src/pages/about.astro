        >
      </a>

      <a
        href="https://www.linkedin.com/in/tayeb-hadjou/"
        target="_blank"
        class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
      >
        <span class="sr-only">LinkedIn</span>
        <svg
          class="w-14 h-14 sm:w-16 sm:h-16"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.5c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.5h-3v-5.5c0-1.379-1.121-2.5-2.5-2.5s-2.5 1.121-2.5 2.5v5.5h-3v-10h3v1.5c.878-1.314 2.314-2.5 4-2.5 2.485 0 4.5 2.015 4.5 4.5v6.5z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </a>
      
    </span>
    
</Layout>
<script>
  const fotterElement = document.getElementById('footer');
  const headerElement = document.getElementById('header');
  headerElement.classList.remove('hidden');
  fotterElement.classList.remove('hidden');
</script>
