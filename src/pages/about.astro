---
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";
import AboutExperience from "../components/about-experience.astro";
import education from "../collections/education.json";
---

<Layout title="About Me">
  <section class="relative z-20 max-w-4xl mx-auto my-12 px-4 sm:px-7 lg:px-0 mt-32 ">
    <PageHeading
      title="À propos de moi"
      description="Bonjour 👋 Je suis étudiant en informatique, spécialisé en développement fullstack. Naturellement curieux, je m'intéresse à divers domaines et je suis toujours en quête de nouvelles connaissances pour améliorer mes compétences"
        />
    
  <img src="/portfolio/assets/images/about/about.jpg"  loading="lazy" class="relative z-30 my-8 mx-auto h-[200px] md:h-[380px] w-full max-w-full object-cover rounded-xl" />

    <h2 class="mb-3 text-2xl font-bold dark:text-neutral-200">Mes compétences en développement web</h2>
    <p
      class="text-sm leading-6  dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-2"
    >
    Je maîtrise plusieurs langages de programmation ainsi que des frameworks back-end et front-end. J’ai également de solides compétences en gestion de bases de données 
    </p>
    <div id="skills_block" class="flex flex-col sm:flex-row flex-wrap gap-4 w-full items-stretch justify-center">
      <div id="skills_front" class="bg-white w-full max-w-[240px] sm:w-60 h-auto min-h-48 mt-2 p-4 border rounded-2xl flex flex-col items-center text-center">
          <img src="/portfolio/assets/images/about/frontEnd.jpg"  loading="lazy" class="w-12 h-12 mx-auto" />
          <h3 class="mt-4 text-lg">Developement Frontend</h3>
          <p class="text-sm leading-6 "
          >
          Développement d’applications web avec NextJS, ReactJS et VueJS
          </p>
      </div>
      <div id="skills_back" class="bg-white w-full max-w-[240px] sm:w-60 h-auto min-h-48 mt-2 p-4 border rounded-2xl flex flex-col items-center text-center">
        <img src="/portfolio/assets/images/about/server.jpg"  loading="lazy" class="w-10 h-10 mx-auto" />
        <h3 class="mt-4 text-lg">Developement Backend</h3>
        <p class="text-sm leading-6 " 
        >
         Développement d’API avec Node, PHP, Python et Java
        </p>
      </div>
      <div id="skills_db" class="bg-white w-full max-w-[240px] sm:w-60 h-auto min-h-48 mt-2 p-4 border rounded-2xl flex flex-col items-center text-center">
        <img src="/portfolio/assets/images/about/db.jpg"  loading="lazy" class="w-10 h-10 mx-auto" />
        <h3 class="mt-4 text-lg">BDD</h3>
        <p class="text-sm leading-6 "
        >
        Gestion de bases de données avec MySQL, MongoDB et PostgreSQL
        </p>
      </div>
    </div>
    <h2 class="mt-8 mb-3 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200">Autres compétences</h2>
    <p
      class="text-sm leading-6  dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-2"
    >
    En plus de mes compétences en développement web, je maîtrise également divers outils de programmation et environnements de développement, tels que VSCode, IntelliJ, SonarQube, Docker... <br>
    Au cours de mes études et de mon stage, j’ai pratiqué le développement DevOps, les tests, le déploiement, ainsi que les méthodologies CI/CD, TDD et BDD pour gérer et développer des projets.
    </p>

    <h2
      class="mt-8 mb-3 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
    Expérience
    </h2>
    <div class="px-5 pt-4 pb-4 ml-2">
      <div class=" border-gray-200 dark:border-neutral-700">
        <AboutExperience
          dates="May 2022 . August 2022  "
          role="Stagiaire développeur web"
          company="Aezan Services"
          description="Développeur front-end en REACT/REDUX pour une plateforme de visioconférence "
          logo="/portfolio/assets/images/about/aezan.jpg"
        />
      </div>
    </div>
    <h2
    class="mt-8 mb-3 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
    Education
    </h2>
    <div class="px-5 pt-4 pb-4 ml-2 w-full">
      {
        education.map((education, loop) => {
          return (
            <>
              {loop == 0 || loop == 1 ? (
                <div class="pb-10 border-l  dark:border-neutral-700">
                  <AboutExperience
                    dates={education.dates}
                    role={education.role}
                    company={education.company}
                    description={education.description}
                    logo={education.logo}
                  />
                </div>
              ) : (
                <AboutExperience
                    dates={education.dates}
                    role={education.role}
                    company={education.company}
                    description={education.description}
                    logo={education.logo}
                />
              )}
            </>
          )
        })
      }
      
    </div>
        <h2
      class="mt-8 mb-3 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
      >
      CV
    </h2>
    <p       class="text-sm leading-6  dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-2"
    >
      Voici mon CV :
    </p>
    <a
      target="_blank"
      href="/portfolio/assets/images/CV_Hadjou_Tayeb.pdf"
      class="relative bg-white flex flex-col items-stretch duration-300 ease-out p-4 sm:p-5 group rounded-2xl w-full max-w-[450px] h-auto aspect-[3/4] m-auto overflow-hidden"
      download
    >
      <img 
        src="/portfolio/assets/images/CV_l.jpg" 
        alt="CV" 
        loading="lazy"
        class="absolute inset-0 z-10 block w-full h-full object-cover duration-300 ease-out border rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:opacity-50 group-hover:border-[#ffdc5d]" />
                        <svg
            class="w-0 h-0 transition-transform duration-300 ease-out  group-hover:w-6 group-hover:h-6 absolute inset-0 m-auto "
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
          <path d="M12.5535 16.5061C12.4114 16.6615 12.2106 16.75 12 16.75C11.7894 16.75 11.5886 16.6615 11.4465 16.5061L7.44648 12.1311C7.16698 11.8254 7.18822 11.351 7.49392 11.0715C7.79963 10.792 8.27402 10.8132 8.55352 11.1189L11.25 14.0682V3C11.25 2.58579 11.5858 2.25 12 2.25C12.4142 2.25 12.75 2.58579 12.75 3V14.0682L15.4465 11.1189C15.726 10.8132 16.2004 10.792 16.5061 11.0715C16.8118 11.351 16.833 11.8254 16.5535 12.1311L12.5535 16.5061Z" fill="#1C274C"/>
          <path d="M3.75 15C3.75 14.5858 3.41422 14.25 3 14.25C2.58579 14.25 2.25 14.5858 2.25 15V15.0549C2.24998 16.4225 2.24996 17.5248 2.36652 18.3918C2.48754 19.2919 2.74643 20.0497 3.34835 20.6516C3.95027 21.2536 4.70814 21.5125 5.60825 21.6335C6.47522 21.75 7.57754 21.75 8.94513 21.75H15.0549C16.4225 21.75 17.5248 21.75 18.3918 21.6335C19.2919 21.5125 20.0497 21.2536 20.6517 20.6516C21.2536 20.0497 21.5125 19.2919 21.6335 18.3918C21.75 17.5248 21.75 16.4225 21.75 15.0549V15C21.75 14.5858 21.4142 14.25 21 14.25C20.5858 14.25 20.25 14.5858 20.25 15C20.25 16.4354 20.2484 17.4365 20.1469 18.1919C20.0482 18.9257 19.8678 19.3142 19.591 19.591C19.3142 19.8678 18.9257 20.0482 18.1919 20.1469C17.4365 20.2484 16.4354 20.25 15 20.25H9C7.56459 20.25 6.56347 20.2484 5.80812 20.1469C5.07435 20.0482 4.68577 19.8678 4.40901 19.591C4.13225 19.3142 3.9518 18.9257 3.85315 18.1919C3.75159 17.4365 3.75 16.4354 3.75 15Z" fill="#1C274C"/>
          
        </svg></img>

            
      </a>
    <h2
      class="mt-8 mb-3 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
      >
      Contact
    </h2>
    <p
      class="text-sm leading-6  dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-2"
    >

      Voici mes réseaux sociaux et mon adresse email : <a class=" underline" href="mailto:massihadjou0@gmail.com "> massihadjou0@gmail.com </a>
    </p>
    <span
      class="flex flex-wrap justify-center gap-6 mt-8 px-2"
    >

      <a
        href="https://www.instagram.com/hadjou_massi/"
        target="_blank"
        class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
      >
        <span class="sr-only">Instagram</span>
        <svg
          class="w-14 h-14 sm:w-16 sm:h-16"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
            clip-rule="evenodd"></path></svg
        >
      </a>

      <a
        href="https://github.com/tayeb-hadjou"
        target="_blank"
        class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
      >
        <span class="sr-only">GitHub</span>
        <svg
          class="w-14 h-14 sm:w-16 sm:h-16"
          fill="currentColor"
          viewBox="2 2 20 20"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
